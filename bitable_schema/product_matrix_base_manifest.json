          "type": "text"
        },
        {
          "name": "项目号（仅飞书）",
          "type": "text"
        },
        {
          "name": "关联 SKU",
          "type": "link",
          "detail": {
            "target_table": "SKU（plm数据）",
            "note": "预留，由操作者手工建立并填写"
