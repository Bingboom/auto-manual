{
  "schema_version": "bitable-schema/v1",
  "note": "产品信息矩阵（发布文档管理 base）的五张表。名称为键，不含 id 和数据；每张表第一个字段是主字段。link 类型字段由人工在飞书界面建立（apply 只列出不创建）。契约见 code-as-doc/dev/product_matrix_base.md。",
  "tables": [
    {
      "name": "产品",
      "fields": [
        {
          "name": "产品键",
          "type": "text"
        },
        {
          "name": "型号",
          "type": "text"
        },
        {
          "name": "市场",
          "type": "select",
          "multiple": false,
          "options": [
            "US",
            "EU",
            "UK",
            "JP",
            "CN",
            "TW",
            "KR",
            "AU",
            "PH",
            "BR"
          ]
        },
        {
          "name": "代际",
          "type": "text"
        },
        {
          "name": "品牌",
          "type": "select",
          "multiple": false,
          "options": [
            "自有"
          ]
        },
        {
          "name": "商品简称",
          "type": "text"
        },
        {
          "name": "产品类别",
          "type": "select",
          "multiple": false,
          "options": [
            "便携储能",
            "家庭备电",
            "加电包",
            "太阳能板",
            "配件"
          ]
        },
        {
          "name": "产品系列",
          "type": "select",
          "multiple": false,
          "options": [
            "标准",
            "Plus",
            "PlusV2",
            "Pro",
            "ProMax",
            "Ultra",
            "卫士",
            "充电宝",
            "SolarSaga",
            "SolarSaga Air",
            "充电与输入",
            "连接与配电",
            "保护与搬运"
          ]
        },
        {
          "name": "容量档",
          "type": "select",
          "multiple": false,
          "options": [
            "1度以下",
            "1度电",
            "1.2度电",
            "1.5度电",
            "1.8度电",
            "2度电",
            "3度电",
            "3.6度电",
            "5度电"
          ]
