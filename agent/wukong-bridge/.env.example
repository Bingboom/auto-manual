# Copy these variable names into an environment file outside the repository.
# Replace placeholder paths locally; never add credentials to this template.
AUTO_MANUAL_REPO_ROOT=/absolute/path/to/auto-manual2
AUTO_MANUAL_CONTROL_CONFIG=/absolute/path/to/auto-manual2/configs/config.us.yaml
LARK_CLI_PROFILE=prod
LARK_CLI_IDENTITY=bot
HELLO_DOCS_BRIDGE_STATE_DIR=/absolute/path/to/external/hello-docs-bridge-state

# Optional: only for a deliberately separate Hello-Docs mirror checkout.
# HELLO_DOCS_MIRROR_ROOT=/absolute/path/to/Hello-Docs
