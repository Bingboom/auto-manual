.venv/
.tmp/

# Build outputs
docs/_build/*
!docs/_build/*/
docs/_build/*/*
!docs/_build/*/*/
docs/_build/*/*/*
!docs/_build/*/*/rst/
!docs/_build/*/*/rst/**
docs/generated/

# Runtime release output is delivered through Feishu / GitHub Actions, not Git.
/reports/releases/

# Delivery outbox: the hand-off drop that the DingTalk delivery agent consumes
# (tools/delivery_outbox.py, AUTO_MANUAL_DELIVERY_OUTBOX_ROOT). Runtime payloads
# never belong in Git, and this pattern also covers the mirror checkout because
# sync-hello-docs.yml carries this file into the mirror tree.
/output/

# Hello-Docs commits only Web source/assets below docs/publish. These patterns
# are a staging backstop; publish_branch_assembly.py also rejects them before push.
/docs/publish/**/*.idml
/docs/publish/**/*.indd
/docs/publish/**/*.indb
/docs/publish/**/*.tex
/docs/publish/**/*.ltx
/docs/publish/**/*.pdf
/docs/publish/**/*.doc
/docs/publish/**/*.docx
/docs/publish/**/*.zip

# Local Feishu/Lark snapshot data; each mirror repo syncs its own Base.
# page_registry.csv is the repo-maintained page-structure input that sync-data
# copies into the snapshot; it must stay tracked or fresh checkouts cannot sync.
data/phase2/*
!data/phase2/page_registry.csv

# Python caches
**/__pycache__/
*.pyc

# OS junk
.DS_Store

# OpenClaw integration runtime
integrations/openclaw/auto-manual-control-layer/node_modules/
integrations/openclaw/auto-manual-control-layer/runtime/
integrations/openclaw/feishu-im-webhook-adapter/node_modules/
integrations/openclaw/feishu-im-webhook-adapter/runtime/
integrations/openclaw/dingtalk-im-adapter/node_modules/
integrations/openclaw/dingtalk-im-adapter/runtime/

# OpenClaw local-only operator profile and workspace notes
.openclaw/
HEARTBEAT.md
TOOLS.md
# BlockClaw per-machine agent memory (session keys / staffIds); never sync via the mirror
/memory/
# Root persona stubs: the real persona lives in agent/ and is injected via the
# bootstrap-extra-files hook; these root files are machine-local placeholders
# maintained by integrations/openclaw/scripts/ensure_blockclaw_persona_wiring.mjs
/IDENTITY.md
/SOUL.md
/USER.md

# Review preview packaging
site/review-preview/dist/

# AI assistant local config (each operator owns their own permissions and profile)
.claude/settings.local.json
