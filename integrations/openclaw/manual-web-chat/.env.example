# Configure on the Hello-Docs Mac host. Keep the real file outside Git.
HT_DOCS_CHAT_PORT=8793
HT_DOCS_CHAT_ALLOWED_ORIGINS=https://ht-docs-ht-manuals.readthedocs-hosted.com
HT_DOCS_CHAT_MANUAL_BASE_URL=https://ht-docs-ht-manuals.readthedocs-hosted.com/en/latest
# SHA-256 of the separate reader-facing Q&A password, not a gateway/API token.
HT_DOCS_CHAT_PASSWORD_SHA256=
# RTD private sharing HTTP-header token, if required. Server-side only.
HT_DOCS_CHAT_RTD_TOKEN=
# OpenAI-compatible chat completions endpoint. Reuse an existing provider/model.
HT_DOCS_CHAT_MODEL_URL=
HT_DOCS_CHAT_MODEL=
HT_DOCS_CHAT_MODEL_KEY=
