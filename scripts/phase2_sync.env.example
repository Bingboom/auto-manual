# phase2 sync-data coordinates — 文档构建 Base（业务面镜像）
#
# App Token / Table ID / View ID 都不是密钥，可以提交。凭据不在这里：
# 认证走 lark-cli 的已登录 profile（`lark-cli auth status` 确认 bot 身份 ready），
# 所以本文件不含也不需要 FEISHU_APP_SECRET。
#
# 用法：
#   set -a && . scripts/phase2_sync.env.example && set +a
#   python build.py sync-data --config configs/config.us.yaml
#
# 2026-08-05 用 bot 身份实时枚举核对过，sync-data 全表通过。
# sync-data 的 preflight 要求每张源表的 VIEW_ID 非空，且必须是未过滤的全量视图。

FEISHU_APP_ID=cli_aaa0db0d4b39dcca
FEISHU_PHASE2_IDENTITY=bot

FEISHU_PHASE2_BASE_TOKEN=LD3lb4G1ua4GOVs1vxAc9W2enje

# 能力矩阵：02_主数据_Document_key。九个 checkbox 字段对应
# data/model_capabilities.csv 的九个能力列。
# 注意不要指向 02_主数据_产品信息表（tbl9SuJR2W1P2Rsa）——那张表只有
# 「是否支持加电包」一个能力字段，同步结果是 0 行，会把镜像清成只剩表头。
