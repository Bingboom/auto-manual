* text=auto

*.py text eol=lf
*.sh text eol=lf
*.rst text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=crlf

# Machine-written sync mirrors: sync-data writes LF, and a CRLF checkout makes
# git report a phantom modification the moment the queue overlays the freshly
# synced copy — which the versioned-publish clean-worktree check then rejects.
# These files are read by code and edited in Feishu, never hand-edited as CSV,
# so pin them to the writer's LF instead of the operator-facing CRLF default.
data/phase2/page_registry.csv text eol=lf
data/model_capabilities.csv text eol=lf
data/asset_registry.csv text eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
.githooks/pre-push text eol=lf
.githooks/* text eol=lf
.githooks/*.ps1 text eol=crlf
.githooks/*.bat text eol=crlf
.githooks/*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.docx binary
*.otf binary
*.ttf binary
