      ],
      "purpose": "live-copy",
      "text": "11. 本書は再発行いたしませんので紛失しないよう大切に保管してください。"
    },
    {
      "physical_page": 9,
      "line_ids": [
        "p9-b5-l0"
      ],
      "purpose": "live-copy",
      "text": "※保証期間はお買い上げ日より5 年間となります。"
    },
