          ],
          "text": "Symbol\nBedeutung\n"
        },
        {
          "bbox": [
            73.00289916992188,
            339.41778564453125,
            179.9326934814453,
            360.1377868652344
          ],
          "text": "Warn- und Sicherheitssymbole. Unbedingt \nlesen, um auf mögliche Gefahren oder \nRisiken aufmerksam zu machen. \n"
        },
        {
          "bbox": [
            73.00289916992188,
            368.4761657714844,
            158.73387145996094,
            382.1961669921875
          ],
          "text": "Lesen Sie vor der Anwendung die \nBenutzeranleitung.\n"
        },
        {
          "bbox": [
            73.29409790039062,
            392.9761657714844,
            124.77323913574219,
            399.6961669921875
          ],
          "text": "Vermeiden Sie Hitze.\n"
