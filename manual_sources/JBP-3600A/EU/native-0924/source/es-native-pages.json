        {
          "bbox": [
            73.2333984375,
            331.1247863769531,
            166.8654022216797,
            351.84478759765625
          ],
          "text": "Precaución! El incumplimiento de los \nmensajes de advertencia puede \nprovocar lesiones.\n"
        },
        {
          "bbox": [
            73.2333984375,
            367.7095642089844,
            144.0465545654297,
            374.4295654296875
          ],
          "text": "Lea el manual del operador\n"
