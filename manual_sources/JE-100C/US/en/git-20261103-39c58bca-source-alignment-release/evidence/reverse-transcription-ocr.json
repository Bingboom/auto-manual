  {
    "page": 4,
    "id": "sym.weee1",
    "text": "This symbol indicates that the product shall not be disposed of as household waste, and should be delivered to a designated collection facility for recycling.",
    "source_ocr_char_coverage": 0.9697
  },
  {
    "page": 4,
    "id": "sym.weee2",
    "text": "Proper disposal and recycling can help protect the environment. For more information about the disposal and recycling of this product, contact your local community, disposal service, or dealer.",
    "source_ocr_char_coverage": 1.0
  },
  {
    "page": 4,
    "id": "sym.dismantle",
    "text": "Do not dismantle the product.",
    "source_ocr_char_coverage": 1.0
  },
  {
    "page": 4,
    "id": "sym.fire",
    "text": "Keep the product away from fire.",
    "source_ocr_char_coverage": 1.0
  },
  {
    "page": 4,
