    "safety_caution": {
      "page": 101,
      "bbox": [
        66,
        288.05169677734375,
        240,
        307
      ],
      "lines": [
        "Ryzyko pożaru i oparzeń. Nie otwierać, nie zgniatać, nie nagrzewać",
        "powyżej (60°C) ani nie spalać. Przestrzegać instrukcji producenta."
      ]
    },
    "safety_disposal": {
      "page": 101,
      "bbox": [
        18,
        307,
        240,
        351
      ],
      "lines": [
        "Utylizacja baterii w ogniu lub piecu topielniczym, albo mechaniczne zgniatanie lub cięcie baterii",
        "mogą spowodować wybuch.",
        "Pozostawienie baterii w środowisku o wyjątkowo wysokiej temperaturze może spowodować",
        "wybuch lub wyciek łatwopalnej cieczy lub gazu, podobnie jak narażenie jej na działanie skrajnie",
        "niskiego ciśnienia."
      ]
    },
    "maintenance_title": {
